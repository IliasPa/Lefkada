# Copy to .env.local (never commit .env.local) and fill in from your Supabase
# project: URL from Project Settings → Data API; key from Project Settings →
# API Keys → "Publishable key" (sb_publishable_…; the legacy anon key also
# works — NEVER the secret/service_role key). Add the same variables in
# Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR-KEY

# Web push (optional — needed for /admin ▸ Ειδοποιήσεις). Generate once with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Voting (optional): the hash seed mixed into every anonymous voter key —
# SHA-256(seed + device-id + poll-id). Any random string; changing it later
# resets vote deduplication (old voters could vote once more). Defaults to a
# built-in constant when unset.
NEXT_PUBLIC_VOTE_SEED =

# TAXISnet verification (optional, v2.0): set to 1 ONLY once the municipality's
# gov.gr access is approved and the govgr-auth function is configured
# (SETUP_BACKEND.md §13). It shows the "Verify with TAXISnet" button to
# citizens and unlocks the "TAXISnet-verified voters only" switch in /admin.
NEXT_PUBLIC_GOVGR_ENABLED=

# Anonymous ballots (optional, v2.1): the longest random wait, in seconds,
# between a citizen's ticket request and their ballot (default 600 = up to ten
# minutes; the shortest is a tenth of it; 0 = send at once). Leaving the app
# always sends the ballot immediately. If you set it on the host, mirror it in
# the repository's Actions variables (the live-site check needs the same value).
NEXT_PUBLIC_BALLOT_DELAY_MAX_S=
